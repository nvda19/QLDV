# Treat source files as UTF-8 text to prevent the double-encoding (mojibake)
# corruption found across the backend. Line endings are normalized on commit.
*.js     text
*.jsx    text
*.json   text
*.css    text
*.md     text
*.prisma text
*.yml    text
*.yaml   text

# Binary assets — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.xlsx binary
*.xls  binary
*.zip  binary
*.pdf  binary
