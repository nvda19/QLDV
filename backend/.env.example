# =====================================================
# BIẾN MÔI TRƯỜNG - Backend Quản lý Đảng viên
# Copy file này thành .env và điền giá trị thực
# =====================================================

# PostgreSQL Connection String
# Lấy chuỗi kết nối từ Neon Dashboard > Connection Details (nhớ chọn "Pooled connection"
# nếu deploy serverless, hoặc "Direct connection" cho migrate/db push).
# Neon bắt buộc SSL nên phải luôn có ?sslmode=require ở cuối.
# Local:  postgres://postgres:password@localhost:5432/qldv_db
# Neon:   postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require

# Cấu hình bảo mật JWT (JSON Web Token)
# PHẢI thay bằng chuỗi ngẫu nhiên riêng của bạn, không dùng chung với ai khác.
# Tạo chuỗi ngẫu nhiên bằng lệnh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=doi-chuoi-nay-bang-gia-tri-ngau-nhien-cua-ban
JWT_REFRESH_SECRET=doi-chuoi-nay-bang-gia-tri-ngau-nhien-khac

# Khóa mã hóa dữ liệu nhạy cảm (Data Encryption Key) - yêu cầu đúng 32 ký tự
DATA_ENCRYPTION_KEY=doi-thanh-chuoi-dung-32-ky-tu-o-day

# Môi trường chạy ứng dụng (development / production / test)
NODE_ENV=development

# Firebase Configuration (Required for Production/Firebase integration)
# Stringified JSON of the Firebase service account private key file
FIREBASE_SA={"type":"service_account","project_id":"..."}
# Web API Key found in Firebase console (Project Settings -> General)
FIREBASE_API_KEY=AIzaSy...
# (Optional) default is '<project_id>.appspot.com'
FIREBASE_STORAGE_BUCKET=your-bucket-name.appspot.com

# Server Port
PORT=3000
